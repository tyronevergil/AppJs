<!DOCTYPE html>
<!--[if lt IE 9]>      <html class="lt-ie11 lt-ie10 lt-ie9 no-js"> <![endif]-->
<!--[if IE 9]>         <html class="lt-ie11 lt-ie10 no-js"> <![endif]-->
<!--[if IE 10]>        <html class="lt-ie11 no-js"> <![endif]-->
<!--[if gt IE 10]><!-->
<html class="no-js">
<!--<![endif]-->
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - AppJs Framework</title>
    <link href="~/Content/Site.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/app.css" rel="stylesheet" type="text/css" />
    @if (IsSectionDefined("Styles"))
    {
        @RenderSection("Styles", false);
    }
    <script src="~/Scripts/modernizr-2.6.2.js"></script>
    <script src="~/App/app.init.js"></script>
</head>
<body>
    @Html.Partial("_Loader")
    @Html.Partial("_NotSupported")
    @Html.Partial("_NoScript")
    <div class="page">
        @RenderBody()
    </div>
    <script src="~/Scripts/require.js"></script>
    <script src="~/App/app.config.js"></script>
    <script src="~/App_Modules/modules.config.js"></script>
    <script src="~/App_Widgets/widgets.config.js"></script>
    <script async src="~/App/app.js"></script>
</body>
</html>