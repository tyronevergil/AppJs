@{ 
    var homeUrl = Url.Action("Index", "Home", new { area = "" });
    var homeAltUrl = homeUrl;
    var widgets = (Context.Request.Query["widgets"].ToString() ?? "");
    if (widgets.ToLower() == "off")
    {
        homeUrl = homeUrl + "?widgets=off";
    }
    else
    {
        homeAltUrl = homeAltUrl + "?widgets=off";
        if (!string.IsNullOrWhiteSpace(widgets))
        {
            homeUrl = homeUrl + "?widgets=" + widgets;
        }
    }
}
<div class="navbar navbar-inverse navbar-fixed-top">
    <div class="container">
        <div class="navbar-header">
            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
            <a app-navigate="alt: '@homeAltUrl', nocascade: true" href="@homeUrl" class="navbar-brand">Home</a>
        </div>
        <div class="navbar-collapse collapse">
            <ul class="nav navbar-nav">
                <li><a app-modal href="@Url.Action("ContactMe", "Home", new { area = "" })">Contact Me</a></li>
            </ul>
        </div>
    </div>
</div>
