<div app-controller="ContactMe">
    <script type="application/json">
        {
            model: {
                Name: "",
                Email: "",
                Message: "" 
            }
        }
    </script>
    <h3>Contact Me</h3>
    <label>Name:</label><input type="text" data-bind="value: Name" /><br/>
    <label>Email:</label><input type="text" data-bind="value: Email" /><br />
    <label>Message</label><br/><textarea data-bind="value: Message"></textarea><br /><br />
    <p data-bind="text: Response"></p>
    <button type="button" app-button="success" app-tooltip="The quick brown fox jumps over the lazy dog" data-bind="click: Submit">Submit</button>
    <button type="button" app-button="danger" style="display: none" data-bind="click: Close, visible: CloseButtonVisible">Close</button>
</div>
